{
  "name": "dsh-github-studio",
  "version": "0.6.0",
  "description": "DeepSeek Harness GitHub 工作台：账号连接、仓库工具、AI 项目介绍与 Release 发布",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "zhaohaix",
  "homepage": "https://github.com/zhaohaix/DeepSeek-GitHub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaohaix/DeepSeek-GitHub.git"
  },
  "bugs": {
    "url": "https://github.com/zhaohaix/DeepSeek-GitHub/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "github",
    "release"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm test && npm run build && node scripts/verify.mjs",
    "release:check": "node scripts/check-public.mjs",
    "release:source": "node scripts/release-source.mjs",
    "prepack": "npm run build && npm run release:check"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
